# ==========================================
# PulsePass - Variables de Entorno de Seguridad
# ==========================================

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/pulsepass
DB_USER=postgres
DB_PASSWORD=postgres

# Configuración JWT (JJWT HS256)
# Issuer esperado en los tokens generados y recibidos
PULSEPASS_JWT_ISSUER=pulsepass-api

# Clave secreta simétrica codificada en Base64 para HS256 (Debe contener al menos 32 bytes / 256 bits aleatorios)
# IMPORTANTE: Generar una clave segura para cada ambiente y NO incluirla en el control de versiones.
# Ejemplo de generación segura en bash: openssl rand -base64 32
PULSEPASS_JWT_SECRET_BASE64=your-base64-encoded-secret-key-at-least-32-bytes-long

# Tiempo de vida del token de acceso (formato ISO-8601 Duration, por defecto 15 minutos: PT15M)
PULSEPASS_JWT_TTL=PT15M
